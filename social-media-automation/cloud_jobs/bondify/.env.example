# Anthropic / Claude Configuration
ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=claude-opus-4-8

# LDS Quotes API Configuration
# Fetch quote data from LDS Quotes Daily Inspiration app API
LDS_QUOTES_API_URL=https://api.ldsquotes.com
LDS_QUOTES_API_KEY=your-api-key-here

# Slack Configuration
# Create a Slack App at https://api.slack.com/apps
# Bot token needs: chat:write, files:write, channels:read
SLACK_BOT_TOKEN=xoxb-...
SLACK_APPROVAL_CHANNEL=#bondify-drafts

# Buffer Configuration (Instagram publishing)
# 1. Create free account at https://buffer.com and verify your email
# 2. Connect your Instagram account as a channel
# 3. Settings → API → Personal Keys → + New Key
# 4. Run: python setup_buffer.py  (prints your channel ID)
BUFFER_ACCESS_TOKEN=your-buffer-personal-key
BUFFER_CHANNEL_ID=

# Cloudinary Configuration (free public image hosting for Buffer)
# 1. Create free account at https://cloudinary.com (cloud name is on the dashboard)
# 2. Settings → Upload → Upload presets → Add upload preset (Signing mode: Unsigned)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_UPLOAD_PRESET=your-unsigned-preset

# Publishing Workflow Configuration
# AUTO_PUBLISH_INSTAGRAM=true  → Post directly to Instagram (no approval needed)
# AUTO_PUBLISH_INSTAGRAM=false → Post to Slack for approval first
AUTO_PUBLISH_INSTAGRAM=false

# REQUIRE_SLACK_APPROVAL=true  → Always post to Slack (even if auto-publishing)
# REQUIRE_SLACK_APPROVAL=false → Skip Slack if auto-publishing is enabled
REQUIRE_SLACK_APPROVAL=true

# Bondify App Configuration
BONDIFY_APP_STORE_URL=https://apps.apple.com/app/bondify/id1234567890

# Runtime Configuration
DEBUG=false
DRY_RUN=false
