# ============================================================================
# LDS QUOTES AGENT - ENVIRONMENT CONFIGURATION
# ============================================================================
#
# Copy this file to .env and fill in your credentials. Never commit .env to Git.
# In production (GitHub Actions), set these as Repository Secrets instead.
#
# ============================================================================
# REQUIRED: LLM Configuration
# ============================================================================

# Anthropic Claude API key (for quote generation and caption writing)
# Get from: https://console.anthropic.com/account/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Which Claude model to use for quote/caption generation
# Recommended: claude-opus-4-8 (most capable, best quality)
# Also available: claude-sonnet-5, claude-haiku-4-5-20251001
LLM_MODEL=claude-opus-4-8

# ============================================================================
# REQUIRED: Slack Configuration
# ============================================================================

# Slack Bot Token (for posting drafts to approval channel)
# Must have scopes: chat:write, files:write
# Get from: https://api.slack.com/apps -> your app -> OAuth & Permissions
SLACK_BOT_TOKEN=xoxb-xxxxxxxxxxxx-xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxx

# Slack channel where drafts are posted for approval
# Must start with # for public channels
SLACK_APPROVAL_CHANNEL=#lds-quotes-social

# ============================================================================
# Publishing
# ============================================================================
# Manual sharing from Slack to Instagram:
# 1. Draft is posted to Slack with image
# 2. Long-click the image in Slack
# 3. Select "Share in Instagram Stories" or "Copy image"
# 4. Share to Instagram directly
#
# This approach requires NO Meta API credentials and costs $0!
# ============================================================================

# ============================================================================
# Runtime Control
# ============================================================================

# Enable debug logging
DEBUG=false

# Dry run mode: generates quote and graphic but doesn't post to Slack
DRY_RUN=false

# ============================================================================
# GitHub Context (auto-set by GitHub Actions, optional for local testing)
# ============================================================================

GITHUB_RUN_ID=
GITHUB_RUN_NUMBER=
GITHUB_SHA=
